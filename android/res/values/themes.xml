<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform's own DayNight theme: no AndroidX, and native screens (setup,
      errors) follow the phone's light/dark setting. The web UI draws its own
      Material You theme inside the WebView; the system bars are tinted to it
      through the HikariApp bridge (MainActivity.setBars).
    -->
    <style name="Theme.HikariWrt" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/seed</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
