<?xml version="1.0" encoding="utf-8"?>
<!--
  The sun of public/favicon.svg (a 24x24 drawing), as the adaptive icon's
  foreground: scaled 2.5x into the 108 dp canvas and centred, which keeps it
  well inside the 66 dp safe zone every launcher mask leaves visible. Also used
  as the monochrome layer for themed icons (only its alpha is used there).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="24" android:translateY="24" android:scaleX="2.5" android:scaleY="2.5">
        <path
            android:pathData="M8.4,12a3.6,3.6 0 1,0 7.2,0a3.6,3.6 0 1,0 -7.2,0"
            android:strokeColor="@color/icon_ink"
            android:strokeWidth="2"
            android:fillColor="#00000000" />
        <path
            android:pathData="M12,3.5v2M12,18.5v2M3.5,12h2M18.5,12h2M6,6l1.4,1.4M16.6,16.6L18,18M6,18l1.4,-1.4M16.6,7.4L18,6"
            android:strokeColor="@color/icon_ink"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
