<?xml version="1.0" encoding="utf-8"?>
<!--
  HikariWrt for Android: the router's web UI (/webui/) in a full-screen WebView.

  Only two permissions: INTERNET to reach the router, ACCESS_NETWORK_STATE to
  read this network's gateway and offer it on the setup screen. Nothing else -
  the backup download goes through MediaStore, which needs no storage
  permission on Android 10+ (minSdk 29).

  versionCode, versionName, minSdk and targetSdk are passed to aapt2 by
  build.sh rather than written here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="moe.hikarishii.hikariwrt">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The router's web UI is plain HTTP on the LAN (see network_security_config). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.HikariWrt"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!--
          singleTask: the launcher shortcut "Change router address" reaches the
          running instance (onNewIntent) instead of stacking a second WebView.
          configChanges: rotation and resizing don't reload the page. uiMode is
          left out on purpose - a light/dark switch recreates the activity, which
          is what makes the WebView's prefers-color-scheme follow the phone.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
