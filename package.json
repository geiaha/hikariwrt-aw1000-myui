{
  "name": "hikari-ui",
  "version": "0.1.0",
  "private": true,
  "description": "HikariWrt admin UI for the Arcadyan AW1000: a Material You front end over rpcd/ubus, with LuCI kept for advanced settings.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "deploy": "sh scripts/deploy.sh",
    "package": "sh scripts/package.sh"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "pinia": "^4.0.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
